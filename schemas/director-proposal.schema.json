{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "kind",
    "summary",
    "rationale",
    "required_facts",
    "state_preconditions",
    "transition_intent",
    "source_refs",
    "design_status",
    "provider_trace"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "required_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state_preconditions": {
      "type": "array"
    },
    "transition_intent": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "design_status": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_trace": {
      "type": "object"
    }
  }
}
