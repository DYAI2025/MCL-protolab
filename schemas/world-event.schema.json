{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "actor_refs",
    "location_ref",
    "payload",
    "source_refs",
    "evidence_class"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "actor_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location_ref": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_class": {
      "type": "string",
      "minLength": 1
    }
  }
}
