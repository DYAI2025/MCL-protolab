{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "hypothesis",
    "design_status",
    "source_refs",
    "runtime_adapter",
    "mechanics",
    "assets",
    "tunables",
    "success_signals",
    "kill_criteria",
    "reset_strategy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "design_status": {
      "enum": [
        "STATED",
        "TENTATIVE",
        "AMBIGUOUS",
        "CONFLICT"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "runtime_adapter": {
      "type": [
        "string",
        "null"
      ]
    },
    "mechanics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tunables": {
      "type": "object"
    },
    "success_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "kill_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reset_strategy": {
      "type": "string",
      "minLength": 1
    }
  }
}
