{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replay_id",
    "start_state_ref",
    "transition_refs",
    "source_refs",
    "revision"
  ],
  "properties": {
    "replay_id": {
      "type": "string",
      "minLength": 1
    },
    "start_state_ref": {
      "type": "string",
      "minLength": 1
    },
    "transition_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
