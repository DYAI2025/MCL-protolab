{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transition_id",
    "source_state_ref",
    "proposal_ref",
    "operations",
    "source_refs",
    "revision"
  ],
  "properties": {
    "transition_id": {
      "type": "string",
      "minLength": 1
    },
    "source_state_ref": {
      "type": "string",
      "minLength": 1
    },
    "proposal_ref": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "flag_ref", "value"],
            "properties": {
              "op": {
                "const": "SET_WORLD_FLAG"
              },
              "flag_ref": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
