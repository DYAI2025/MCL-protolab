{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_id",
    "entities",
    "locations",
    "factions",
    "relationships",
    "quests",
    "inventory",
    "world_flags",
    "calendar",
    "active_events",
    "source_refs",
    "revision"
  ],
  "properties": {
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array"
    },
    "locations": {
      "type": "array"
    },
    "factions": {
      "type": "array"
    },
    "relationships": {
      "type": "array"
    },
    "quests": {
      "type": "array"
    },
    "inventory": {
      "type": "array"
    },
    "world_flags": {
      "type": "object"
    },
    "calendar": {
      "type": "object"
    },
    "active_events": {
      "type": "array"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
